{
  "name": "benchmark-core",
  "version": "0.1.0",
  "description": "Typed engine for building AI benchmarks with SDK, CLI, MCP, and HTTP API surfaces.",
  "keywords": [
    "ai-benchmark",
    "llm-evaluation",
    "model-evaluation",
    "evals",
    "grading",
    "openrouter",
    "openai",
    "mcp",
    "typescript",
    "benchmark-runner"
  ],
  "homepage": "https://aibenchmarkindex.com",
  "bugs": "https://github.com/pooriaarab/benchmark-core/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/benchmark-core.git"
  },
  "license": "MIT",
  "author": "Pooria Arab",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "benchmark-core": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "server.json",
    "examples/echo/data"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint src examples scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "e2e": "node scripts/e2e.mjs",
    "ci:local": "npm run lint && npm run typecheck && npm run build && npm run e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@xmldom/xmldom": "^0.9.12",
    "oxlint": "^1.23.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
